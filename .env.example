# Ollama host — use 127.0.0.1 on Windows (localhost resolves to IPv6 ::1)
OLLAMA_HOST=http://127.0.0.1:11434

# Models to benchmark (comma-separated, must be pulled in Ollama)
BENCH_MODELS=qwen3:4b,qwen2.5:7b-instruct

# How many runs per (model, prompt) cell — more = more stable averages
RUNS_PER_CELL=2
